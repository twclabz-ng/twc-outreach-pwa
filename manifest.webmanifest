{
  "id": "./",
  "name": "TWC Outreach Tracker | MedCRM",
  "short_name": "TWC Outreach",
  "description": "Clinical Outreach & Epidemiological Surveillance PWA with iOS UI Skin, Personnel Invitations, and Google Apps Script Sync.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F2F2F7",
